# ShareBite Environment Variables Configuration Example
# Copy to .env or load directly into runtime

# MongoDB
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/sharebite

# Server Port
SERVER_PORT=8080

# JWT Authentication Secret (Must be at least 256-bit / 32 characters)
SHAREBITE_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
SHAREBITE_JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
SHAREBITE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Demo Data Initialization
SHAREBITE_SEED_DEMO_DATA=true

# Frontend Vite Proxy
VITE_API_URL=http://localhost:8080
